#!/bin/sh
set -e

case "$1" in
    configure)
        # Create global library directory for innodek packages
        mkdir -p /usr/local/lib/lang
        chmod 755 /usr/local/lib/lang

        echo "Innodek initialized successfully!"
        echo "Package directory created at /usr/local/lib/lang"
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0

